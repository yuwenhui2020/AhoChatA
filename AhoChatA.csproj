  <!-- ================= AOT 例外 =================
       全量 AOT / Profiled AOT 都会在 Xamarin.Google.Android.Material.dll 上报 XA3001：
       Material 1.0.0.1 太旧，其 typeref 指向 AppCompat 1.6.1 中已改名的
       AndroidX.AppCompat.Graphics.Drawable.DrawableWrapper。AOT 编译器必须解析全部
       token，而 JIT 是惰性的，所以运行时一直正常、只有 AOT 编译失败。
       这里仅把该程序集从「AOT 输入列表」临时摘掉，编译完立刻放回：
       它仍会完整打进 APK（运行时由 JIT 处理），其余程序集全部走 AOT。 -->
  <Target Name="_MchatAotExclude" BeforeTargets="_AndroidAot">
    <ItemGroup>
      <_MchatAotSkip Include="@(_ShrunkAssemblies->WithMetadataValue('Filename','Xamarin.Google.Android.Material'))" />
      <_ShrunkAssemblies Remove="@(_MchatAotSkip)" />
    </ItemGroup>
    <Message Importance="normal" Text="AOT: 跳过 @(_MchatAotSkip)（AndroidX 绑定版本错配），其余程序集正常预编译" />
  </Target>
  <Target Name="_MchatAotRestore" AfterTargets="_AndroidAot">
    <ItemGroup>
      <_ShrunkAssemblies Include="@(_MchatAotSkip)" />
    </ItemGroup>
  </Target>
</Project>