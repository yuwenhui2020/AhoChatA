    <!-- AOT：IL 预编译为各 ABI 原生代码，省掉运行时 JIT，冷启动与 CPU 密集路径更快。
         本项目的 Debug 配置就是实际分发包（Debuggable=false / 无调试符号），故同样开启。
         前提：需要 Android NDK 提供汇编/链接工具链；构建会变慢、APK 会变大。
         临时回退：msbuild AhoChatA.csproj /p:AotAssemblies=false -->
    <AotAssemblies>true</AotAssemblies>
    <AndroidAotMode>Normal</AndroidAotMode>
    <EnableLLVM>false</EnableLLVM>
    <!-- Profiled AOT（Startup Tracing）：按内置 startup.aotprofile 只预编译启动热路径。
         全量 AOT 会在 Xamarin.Google.Android.Material.dll 上报 XA3001（AndroidX 绑定包
         对 DrawableWrapper 的 typeref 解析不了），Profiled AOT 可绕开且体积/构建时间更省。 -->
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <BundleAssemblies>false</BundleAssemblies>
    <AndroidEnableSGenConcurrent>false</AndroidEnableSGenConcurrent>
    <!-- 不把任何 .pdb/.mdb 调试符号打进 APK，缩小体积 -->
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
    <!-- 非调试用途的分发包：去掉 debug 插桩，进一步减小体积 -->
    <Debuggable>false</Debuggable>
    <AndroidSupportedAbis />
  </PropertyGroup>
