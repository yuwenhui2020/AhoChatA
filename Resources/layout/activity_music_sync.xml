<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFAFAFA"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="局域网音乐同步"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF222222"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 角色切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="12dp">
        <Button
            android:id="@+id/btnModeServer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="服务器端"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#FFE0E0E0" />
        <Button
            android:id="@+id/btnModePlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="播放器端"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FFE0E0E0" />
    </LinearLayout>

    <!-- 音源选择（服务器端可见） -->
    <LinearLayout
        android:id="@+id/laySource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="音源"
            android:textSize="14sp"
            android:textColor="#FF666666" />
        <Spinner
            android:id="@+id/spinnerSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <Button
                android:id="@+id/btnPickFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择文件"
                android:layout_marginEnd="6dp" />
            <EditText
                android:id="@+id/etUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="或输入 HTTP 流地址"
                android:inputType="textUri"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 设备列表 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="局域网设备"
        android:textSize="14sp"
        android:textColor="#FF666666" />
    <ListView
        android:id="@+id/lvDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#FFFFFFFF"
        android:divider="#FFDDDDDD"
        android:dividerHeight="1dp" />

    <!-- 控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始"
            android:backgroundTint="#FF3F8CFF"
            android:textColor="#FFFFFFFF" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFE53935"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <!-- 状态与统计 -->
    <TextView
        android:id="@+id/tvState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态：未连接"
        android:textSize="14sp"
        android:textColor="#FF333333"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="码率: - kbps | 延迟: - ms | 缓冲: - ms"
        android:textSize="12sp"
        android:textColor="#FF888888"
        android:layout_marginTop="2dp" />

    <!-- 音量（播放器端） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音量"
            android:textSize="12sp"
            android:textColor="#FF666666" />
        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
