<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0d10">

    <!-- 对端画面（视频通话） -->
    <TextureView
        android:id="@+id/callRemote"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 语音通话 / 视频未接通时的占位 -->
    <LinearLayout
        android:id="@+id/callPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/callAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="#1f242c" />

        <TextView
            android:id="@+id/callPeer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#e6e8eb"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9aa0a6"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 顶部通话信息：仅调整覆盖层，不给远端画面添加边距 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#66000000"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/callTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:textColor="#d8dce2"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 本地小窗 -->
    <FrameLayout
        android:id="@+id/callLocalBox"
        android:layout_width="96dp"
        android:layout_height="128dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="#1f242c"
        android:visibility="gone">

        <TextureView
            android:id="@+id/callLocal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:id="@+id/callButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="40dp"
        android:paddingTop="18dp">

        <FrameLayout
            android:id="@+id/callMute"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/call_btn" />

        <FrameLayout
            android:id="@+id/callSpeaker"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/call_btn" />

        <FrameLayout
            android:id="@+id/callSwitch"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/call_btn" />

        <FrameLayout
            android:id="@+id/callHangup"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/call_btn" />
    </LinearLayout>

    <!-- 来电：接听 / 拒绝 -->
    <LinearLayout
        android:id="@+id/callIncomingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/callReject"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/call_btn" />

        <FrameLayout
            android:id="@+id/callAccept"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/call_btn" />
    </LinearLayout>
</FrameLayout>
