<resources>

    <!-- Base application theme (framework Material theme; no external Material Components dependency) -->
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/lc_accent</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/lc_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lc_page_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/lc_page_bg</item>
        <item name="android:navigationBarColor">@color/lc_page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/lc_accent</item>
        <item name="android:colorPrimary">@color/lc_accent</item>
        <item name="android:colorControlActivated">@color/lc_accent</item>
        <item name="android:alertDialogTheme">@style/IosDialog</item>
    </style>

    <!-- Splash uses the same light page background; artwork is controlled by SplashActivity. -->
    <style name="AppTheme.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lc_page_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/lc_page_bg</item>
        <item name="android:navigationBarColor">@color/lc_page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/lc_accent</item>
        <item name="android:colorPrimary">@color/lc_accent</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="android:Theme.Material" />

    <style name="AppTheme.PopupOverlay" parent="android:Theme.Material.Light" />

    <!-- Dark-mode framework dialogs, controls, and system bars use the shared neutral palette. -->
    <style name="AppTheme.NoActionBar.Night" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lc_night_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/lc_night_bg</item>
        <item name="android:navigationBarColor">@color/lc_night_bg</item>
        <item name="android:colorAccent">@color/lc_accent</item>
        <item name="android:colorPrimary">@color/lc_accent</item>
        <item name="android:colorControlActivated">@color/lc_accent</item>
        <item name="android:textColor">@color/lc_night_text</item>
        <item name="android:textColorPrimary">@color/lc_night_text</item>
        <item name="android:textColorSecondary">@color/lc_night_sub</item>
        <item name="android:alertDialogTheme">@style/IosDialog.Night</item>
    </style>

    <!-- iOS 风格原生弹窗：圆角卡片 + 蓝色非全大写按钮。所有 AlertDialog.Builder(this) 自动生效。 -->
    <style name="IosDialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@drawable/ios_dialog_bg</item>
        <!-- 三个按钮（含较长文案）需要足够宽度才不会被 ButtonBarLayout 竖排堆叠；
             280dp 时按钮总宽刚好卡在阈值，导致「复制导航页/打开导航页/关闭」等竖排。 -->
        <item name="android:windowMinWidthMajor">340dp</item>
        <item name="android:windowMinWidthMinor">340dp</item>
        <item name="android:colorAccent">@color/lc_accent</item>
        <item name="android:textColorPrimary">@color/lc_text</item>
        <item name="android:textColorSecondary">@color/lc_sub</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/IosDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/IosDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/IosDialogButton</item>
    </style>

    <style name="IosDialog.Night" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/ios_dialog_bg_night</item>
        <item name="android:windowMinWidthMajor">340dp</item>
        <item name="android:windowMinWidthMinor">340dp</item>
        <item name="android:colorAccent">#0A84FF</item>
        <item name="android:textColorPrimary">@color/lc_night_text</item>
        <item name="android:textColorSecondary">@color/lc_night_sub</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/IosDialogButton.Night</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/IosDialogButton.Night</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/IosDialogButton.Night</item>
    </style>

    <!-- 缩小单按钮最小宽度与左右内边距，配合 340dp 弹窗宽度让三按钮保持一行 -->
    <style name="IosDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/lc_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="IosDialogButton.Night" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#0A84FF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

</resources>
