      "short_name": "新建",
      "description": "创建新的聊天会话",
      "url": "/#new-chat",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "文件传输",
      "short_name": "文件",
      "description": "发送文件给局域网设备",
      "url": "/#file-transfer",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/chat.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "聊天界面"
    },
    {
      "src": "/screenshots/media.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "媒体库"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "background_sync": {
    "messages": {
      "min_interval": 30000
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+mchat",
      "url": "/?action=%s"
    }
  ]
